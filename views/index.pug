doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    style.
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background-color: #f3f6fb;
        color: #1f2937;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      .container {
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(0,0,0,0.08);
        padding: 40px 32px;
        text-align: center;
        width: min(90%, 500px);
      }

      h1 {
        margin: 0 0 12px;
        font-size: 2.2rem;
      }

      p {
        margin: 0 0 22px;
        color: #4b5563;
      }

      a {
        display: inline-block;
        background-color: #2f6fed;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 10px;
        font-weight: bold;
      }
  body
    .container
      h1= message
      p Sistema para administrar turnos de clientes.
      a(href="/turnos") Ver turnos
